# Només per a eines locals de Supabase; no el carrega el navegador.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Exclusivament per al runtime local/de Supabase Functions; mai per al navegador.
# Configura el valor real fora del repositori quan s’autoritzi validar o desplegar la funció.
API_FOOTBALL_KEY=

# Integració antiga sync-live-score, desactivada i no desplegable en aquesta fase.
SYNC_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
