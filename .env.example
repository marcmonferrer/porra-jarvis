# Només per a eines locals de Supabase; no el carrega el navegador.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Referència futura exclusivament de servidor. API-Football està desactivada per a la beta;
# no configuris aquests valors ni despleguis l’Edge Function.
API_FOOTBALL_KEY=server-only
SYNC_SECRET=server-only
SUPABASE_SERVICE_ROLE_KEY=server-only
