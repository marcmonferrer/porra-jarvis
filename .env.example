# Només per a eines locals de Supabase; no el carrega el navegador.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Secrets exclusius d’Edge Functions. No els prefixis amb PUBLIC_ ni els exposis al client.
API_FOOTBALL_KEY=server-only
SYNC_SECRET=server-only
SUPABASE_SERVICE_ROLE_KEY=server-only
